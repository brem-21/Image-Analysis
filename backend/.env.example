# Gemini Flash
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./imdb.db

# Pipeline
CONFIDENCE_THRESHOLD=0.7
OFF_API_BASE=https://world.openfoodfacts.org
GEMINI_TIMEOUT_SECONDS=60

# CORS (comma-separated origins for the frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Runtime / ops
ENVIRONMENT=development        # set to "production" to enforce strict checks
LOG_LEVEL=INFO
API_PREFIX=/api/v1
AUTO_CREATE_TABLES=true        # set false in production; use `alembic upgrade head`

# Upload limits / cost guards (each image is a paid VLM call)
MAX_UPLOAD_FILES=20
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Auth login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
